{
  "name": "shipsite-site-template",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "predev": "node scripts/copy-pdf-assets.mjs && node scripts/prepare-media-assets.mjs",
    "prebuild": "node scripts/copy-pdf-assets.mjs && node scripts/prepare-media-assets.mjs && node scripts/optimize-images.mjs",
    "build": "next build",
    "postbuild": "node scripts/generate-csp-manifest.mjs",
    "deploy": "opennextjs-cloudflare build && wrangler deploy",
    "cf-build": "opennextjs-cloudflare build",
    "cf-preview": "opennextjs-cloudflare preview"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.2",
    "clsx": "2.1.1",
    "fflate": "0.8.3",
    "lamejs": "^1.2.1",
    "next": "16.4.2",
    "pdfjs-dist": "6.3.289",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260724.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "wrangler": "4.114.0"
  },
  "overrides": {
    "brace-expansion@^2": "2.1.7",
    "brace-expansion@^5": "5.0.12",
    "postcss": "8.5.28",
    "qs": "6.16.0",
    "sharp": "0.35.5",
    "undici": "7.30.1",
    "source-map-js": "1.2.2",
    "proxy-addr": "2.0.8",
    "body-parser": "2.4.0"
  }
}
